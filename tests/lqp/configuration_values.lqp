(transaction
  (configure
    { :ast_size.exception_limit 1000
      :ast_size.warning_limit 500
      :ivm.maintenance_level "off"
      :semantics_version 0})
  (epoch
    (writes
      (define
        (fragment :f1
          (def :output ([v::INT] (+ 1 1 v))))))
    (reads
      (output :output :output))))
