(transaction
  (epoch
    (writes
      (define
        (fragment :f1
          ;; Table mode: all columns in one relation, no row ID
          (csv_data
            (csv_locator
              (paths "s3://bucket/edges.csv"))
            (csv_config {})
            (table :edges ["src" "dst"] [INT INT])
            (asof "2025-04-01T00:00:00Z"))

          ;; Table mode with mixed types
          (csv_data
            (csv_locator
              (inline_data "name,score\nAlice,9.5\nBob,8.7"))
            (csv_config {})
            (table :scores ["name" "score"] [STRING FLOAT])
            (asof "2025-04-15T00:00:00Z"))

          ;; Table mode with single column
          (csv_data
            (csv_locator
              (paths "data/tags.csv"))
            (csv_config {})
            (table :tags ["tag"] [STRING])
            (asof "2025-05-01T00:00:00Z"))

          ;; Table mode with custom config
          (csv_data
            (csv_locator
              (paths "data/pipe_separated.csv"))
            (csv_config { :csv_delimiter "|" })
            (table :items ["id" "name" "value"] [INT STRING FLOAT])
            (asof "2025-05-15T00:00:00Z")))))

    (reads
      (output :edges :edges)
      (output :scores :scores)
      (output :tags :tags)
      (output :items :items))))
