(transaction
  (configure { :ivm.maintenance_level "off" :semantics_version 0})
  (epoch
    (writes (define (fragment :frag (def :test ([x::INT] (+ 1 1 x))))))
    (reads
      (export_output
        (csv
          (table_def :test)
          (csv_config
            {
             :csv_compression ""
             :csv_decimal_separator "."
             :csv_delimiter ","
             :csv_encoding "utf-8"
             :csv_escapechar "\""
             :csv_header_row 1i32
             :csv_quotechar "\""
             :csv_skip 0}))))))
