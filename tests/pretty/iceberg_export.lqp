(transaction
  (configure { :ivm.maintenance_level "off" :semantics_version 0})
  (epoch
    (writes
      (define
        (fragment
          :f1
          (def
            :sales
            ([id::INT region::STRING amount::FLOAT]
             (or
               (and (= id 1) (= region "us-east") (= amount 100.0))
               (and (= id 2) (= region "eu-west") (= amount 250.5))))))))
    (reads
      (export_iceberg
        (export_iceberg_config
          (iceberg_locator
            (
            table_name
            "sales")
          (
          namespace
          "db"
          "schema")
        (
        warehouse
        "s3://bucket/warehouse"))
    (iceberg_catalog_config
      (
      catalog_uri
      "https://catalog.example.com")
    (
    properties)
  (
  auth_properties))
(columns
  :sales
  (
  target_columns
  (iceberg_column "id" INT false)
  (iceberg_column "region" STRING false)
  (iceberg_column "amount" FLOAT false)))
(
table_properties)))
(export_iceberg
  (export_iceberg_config
    (iceberg_locator
      (
      table_name
      "sales_archive")
    (
    namespace
    "production")
  (
  warehouse
  "s3://bucket/warehouse"))
(iceberg_catalog_config
  (
  catalog_uri
  "https://catalog.example.com")
(scope "read-only")
(
properties
(prop "client.region" "us-east-1"))
(
auth_properties
(prop "credential" "my-credential")
(prop "token" "secret-token-123")))
(columns
  :sales
  (
  target_columns
  (iceberg_column "id" INT false)
  (iceberg_column "region" STRING false)
  (iceberg_column "amount" FLOAT false)))
(
table_properties
(prop "write.format.default" "parquet"))
{ :compression "SNAPPY" :prefix "part" :target_file_size_bytes 268435456}))
(export_iceberg
  (export_iceberg_config
    (iceberg_locator
      (
      table_name
      "flat_table")
    (
    namespace)
  (
  warehouse
  "s3://bucket/default"))
(iceberg_catalog_config
  (
  catalog_uri
  "https://catalog.example.com")
(
properties)
(
auth_properties))
(columns :sales ( target_columns (iceberg_column "id" INT false)))
(
table_properties))))))
