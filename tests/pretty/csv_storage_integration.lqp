(transaction
  (configure { :ivm.maintenance_level "off" :semantics_version 0})
  (epoch
    (writes
      (define
        (fragment
          :f1
          (csv_data
            (csv_locator (paths "s3://private-bucket/data.csv"))
            (csv_config
              {
               :csv_compression "auto"
               :csv_decimal_separator "."
               :csv_delimiter ","
               :csv_encoding "utf-8"
               :csv_escapechar "\""
               :csv_header_row 1i32
               :csv_quotechar "\""
               :csv_skip 0}
              (storage_integration { :provider "s3" :s3_region "us-west-2"}))
            (columns (column "id" :s3_id [INT]) (column "value" :s3_value [STRING]))
            (asof "2025-04-01T00:00:00Z"))
          (csv_data
            (csv_locator (paths "https://account.blob.core.windows.net/container/data.csv"))
            (csv_config
              {
               :csv_compression "auto"
               :csv_decimal_separator "."
               :csv_delimiter "|"
               :csv_encoding "utf-8"
               :csv_escapechar "\""
               :csv_header_row 1i32
               :csv_quotechar "\""
               :csv_skip 0}
              (storage_integration { :provider "azure"}))
            (columns (column "id" :azure_id [INT]) (column "value" :azure_value [STRING]))
            (asof "2025-04-02T00:00:00Z"))
          (def
            :exported
            ([id::INT value::STRING]
             (or (and (= id 1) (= value "a")) (and (= id 2) (= value "b"))))))))
    (reads
      (output :s3_id :s3_id)
      (output :s3_value :s3_value)
      (output :azure_id :azure_id)
      (output :azure_value :azure_value)
      (export
        (export_csv_config_v2
          (path "s3://private-bucket/export.csv")
          (table_def :exported)
          (csv_config
            {
             :csv_compression "auto"
             :csv_decimal_separator "."
             :csv_delimiter ","
             :csv_encoding "utf-8"
             :csv_escapechar "\""
             :csv_header_row 1i32
             :csv_quotechar "\""
             :csv_skip 0}
            (storage_integration { :provider "s3" :s3_region "eu-central-1"})))))))
