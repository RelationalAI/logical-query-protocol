(transaction
  (configure { :ivm.maintenance_level "off" :semantics_version 0})
  (epoch
    (writes
      (define
        (fragment
          :f1
          (csv_data
            (csv_locator (paths "s3://bucket/edges.csv"))
            (csv_config
              {
               :csv_compression "auto"
               :csv_decimal_separator "."
               :csv_delimiter ","
               :csv_encoding "utf-8"
               :csv_escapechar "\""
               :csv_header_row 1i32
               :csv_quotechar "\""
               :csv_skip 0})
            (table 0x7b31a79c38a81db1da7df4ef1cf8be23 ["src" "dst"] [INT INT])
            (asof "2025-04-01T00:00:00Z"))
          (csv_data
            (csv_locator (inline_data "name,score\nAlice,9.5\nBob,8.7"))
            (csv_config
              {
               :csv_compression "auto"
               :csv_decimal_separator "."
               :csv_delimiter ","
               :csv_encoding "utf-8"
               :csv_escapechar "\""
               :csv_header_row 1i32
               :csv_quotechar "\""
               :csv_skip 0})
            (table 0x75fe6a492e212797315ea43f5ecfa66e ["name" "score"] [STRING FLOAT])
            (asof "2025-04-15T00:00:00Z"))
          (csv_data
            (csv_locator (paths "data/tags.csv"))
            (csv_config
              {
               :csv_compression "auto"
               :csv_decimal_separator "."
               :csv_delimiter ","
               :csv_encoding "utf-8"
               :csv_escapechar "\""
               :csv_header_row 1i32
               :csv_quotechar "\""
               :csv_skip 0})
            (table 0x3748e83f5d0a69e3301569af01e1de93 ["tag"] [STRING])
            (asof "2025-05-01T00:00:00Z"))
          (csv_data
            (csv_locator (paths "data/pipe_separated.csv"))
            (csv_config
              {
               :csv_compression "auto"
               :csv_decimal_separator "."
               :csv_delimiter "|"
               :csv_encoding "utf-8"
               :csv_escapechar "\""
               :csv_header_row 1i32
               :csv_quotechar "\""
               :csv_skip 0})
            (table
              0x27966c98d95c39696e4b2490168e5488
              ["id"
              "name"
              "value"]
              [INT
              STRING
              FLOAT])
            (asof "2025-05-15T00:00:00Z")))))
    (reads
      (output :edges 0x7b31a79c38a81db1da7df4ef1cf8be23)
      (output :scores 0x75fe6a492e212797315ea43f5ecfa66e)
      (output :tags 0x3748e83f5d0a69e3301569af01e1de93)
      (output :items 0x27966c98d95c39696e4b2490168e5488))))

